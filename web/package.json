{
  "name": "ai-agent-market-web",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "description": "Vite + React SPA for AI bid notices (public mirror + internal Cloudflare Pages + D1 app)",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:public": "tsc -b && vite build --mode public",
    "build:internal": "tsc -b && vite build --mode internal",
    "preview": "vite preview",
    "dev:pages": "wrangler pages dev dist --d1=DB --persist-to=.wrangler/state",
    "deploy:internal": "wrangler pages deploy dist --project-name=ai-agent-market-internal",
    "deploy:public": "wrangler pages deploy dist --project-name=ai-agent-market",
    "db:migrate:local": "wrangler d1 migrations apply ai-agent-market --local",
    "db:migrate:remote": "wrangler d1 migrations apply ai-agent-market --remote"
  },
  "dependencies": {
    "@genonai/admin-design-system": "file:./vendor/genonai-admin-design-system",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "~5.6.3",
    "vite": "^5.4.11",
    "wrangler": "^4.45.0"
  }
}

